<%- include('../partials/admin-top') %>
<div class="page-head">
  <h1>Programmes</h1>
  <div class="page-head__actions">
    <a class="link" href="/admin/programmes<%= showArchived ? '' : '?archives=1' %>"><%= showArchived ? 'Masquer les archives' : 'Afficher les archives' %></a>
    <a class="btn btn--ghost" href="/admin/import">Importer des programmes (CSV / Excel)</a>
    <a class="btn btn--primary" href="/admin/programmes/nouveau">+ Nouveau programme</a>
  </div>
</div>
<% if (!programmes.length) { %><div class="panel"><p>Aucun programme. Créez le premier !</p></div><% } %>
<ul class="admin-cards">
  <% programmes.forEach(function (p) { %>
  <li class="admin-card <%= p.status === 'archive' ? 'is-archived' : '' %>">
    <div class="admin-card__media"><% if (p.hero_image) { %><img src="<%= p.hero_image %>" alt="" loading="lazy" width="1600" height="900"><% } else { %><div class="placeholder-visual"></div><% } %></div>
    <div class="admin-card__body">
      <div class="admin-card__top">
        <h2 class="admin-card__title"><a href="/admin/programmes/<%= p.id %>"><%= p.name %></a></h2>
        <span class="prog-status prog-status--<%= p.status %>"><%= fmt.programmeStatus(p.status) %></span>
      </div>
      <p class="muted"><%= p.city %> · <%= p.lot_count %> lots dont <%= p.available_count %> disponibles<% if (p.price_from) { %> · dès <%= fmt.price(p.price_from) %><% } %></p>
      <div class="admin-card__actions">
        <a class="btn btn--small btn--primary" href="/admin/programmes/<%= p.id %>/lots">Gérer les lots</a>
        <a class="btn btn--small btn--ghost" href="/admin/programmes/<%= p.id %>">Modifier</a>
        <a class="btn btn--small btn--ghost" href="/admin/programmes/<%= p.id %>/import">Importer</a>
        <% if (p.status === 'publie') { %><a class="btn btn--small btn--ghost" href="/programmes/<%= p.slug %>" target="_blank" rel="noopener">Voir en ligne</a><% } %>
        <form method="post" action="/admin/programmes/<%= p.id %>/archiver" class="inline-form" <%- p.status === 'archive' ? '' : 'data-confirm="Archiver ce programme ? Il ne sera plus visible sur le site."' %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--small <%= p.status === 'archive' ? 'btn--ghost' : 'btn--danger' %>" type="submit"><%= p.status === 'archive' ? 'Désarchiver' : 'Archiver' %></button>
        </form>
      </div>
    </div>
  </li>
  <% }) %>
</ul>
<%- include('../partials/admin-bottom') %>
