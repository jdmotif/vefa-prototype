# ---------------------------------------------------------------
# Configuration de l'outil de commercialisation VEFA
# Copiez ce fichier en .env puis adaptez les valeurs.
# ---------------------------------------------------------------

# Environnement : development ou production
NODE_ENV=development

# Port HTTP d'écoute
PORT=3000

# URL publique (utilisée dans les liens et l'export). Ex. https://programmes.lescommercialisateurs.com
PUBLIC_URL=http://localhost:3000

# Secret de signature des sessions : chaîne aléatoire longue (au moins 32 caractères).
# Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obligatoire en production.
SESSION_SECRET=

# Compte administrateur initial (créé au premier démarrage si aucun compte n'existe).
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est généré et affiché une seule fois dans la console.
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=

# Chemin du fichier SQLite
DATABASE_PATH=./data/vefa.sqlite

# Dossier de stockage des images envoyées
UPLOAD_DIR=./uploads

# Taille maximale d'une image envoyée (en Mo)
MAX_UPLOAD_MB=5

# Sites autorisés à intégrer l'outil en iframe (séparés par des espaces).
# Exemple : https://www.lescommercialisateurs.com https://lescommercialisateurs.com
FRAME_ANCESTORS='self'

# Mettre à true si l'application est derrière un proxy inverse (Nginx, Caddy, hébergeur PaaS)
TRUST_PROXY=false

# Google Tag Manager (optionnel). Laisser vide pour n'avoir AUCUN traceur.
# Si renseigné, un bandeau de consentement s'affiche et GTM n'est chargé qu'après acceptation.
GTM_ID=

# Remplit automatiquement la base avec les données de démonstration si elle est vide
# (jamais en production).
SEED_ON_EMPTY=true
